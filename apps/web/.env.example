# GovLayer web application environment.
#
# Copy to `.env.local` and fill in real deployed addresses. `.env.local` is
# git-ignored and must never be committed. This file contains placeholders
# only -- never invent or silently default contract addresses.
#
# Configuration is validated at build/runtime boundary (src/config/env.ts).
# Invalid or missing configuration produces an explicit configuration error
# rather than a fallback, per the Frontend Foundation Standard section 7.

# GenLayer network preset. Supported: studionet
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# GovLayerCore contract address (studionet deployment)
NEXT_PUBLIC_GOVLAYER_CORE_ADDRESS=0x0000000000000000000000000000000000000000

# GovLayerAdmin contract address (studionet deployment)
NEXT_PUBLIC_GOVLAYER_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Fixture mode: reserved for isolated UI development only. Defaults to false.
# Fixture values must never appear as live protocol values.
NEXT_PUBLIC_ENABLE_FIXTURES=false
