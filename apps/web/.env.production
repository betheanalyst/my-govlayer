# GovLayer production configuration.
#
# WHY THIS FILE IS COMMITTED
#
# The GovLayerCore / GovLayerAdmin addresses below are the live Studionet
# deployment. They are committed so that a production build always targets a real
# deployment without requiring per-project configuration, which is what made the
# first Vercel deploy fail: a build performed with no NEXT_PUBLIC_* variables
# produced a bundle with no contract addresses.
#
# This keeps the addresses in CONFIGURATION, never in code: `src/config/env.ts`
# still validates them, no source file contains an address, and a network
# migration remains a configuration change.
#
# PRECEDENCE (verified against @next/env 15.3.9)
#
#   real environment variables  >  .env.production.local  >  .env.local
#                               >  .env.production        >  .env
#
# So a variable set in the Vercel project, in CI, or in a local `.env.local`
# always overrides this file. Nothing here can block a future deployment from
# pointing somewhere else -- set the variables in the platform and they win.
#
# These are public testnet contract addresses, not secrets: reading them requires
# no credential, and every value shown by the interface is read from the chain.

# GenLayer network preset. Supported: studionet
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# GovLayerCore contract address (Studionet deployment)
NEXT_PUBLIC_GOVLAYER_CORE_ADDRESS=0xB719b328D0b02d39b20DCc777Cd82c8d724661C9

# GovLayerAdmin contract address (Studionet deployment)
NEXT_PUBLIC_GOVLAYER_ADMIN_ADDRESS=0xdbf8E02B02b1d87ea0599f8F03988f102bd7625A

# Fixture mode stays off in production: fabricated values must never be presented
# as protocol data.
NEXT_PUBLIC_ENABLE_FIXTURES=false
